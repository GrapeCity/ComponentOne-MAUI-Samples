<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c1="clr-namespace:C1.Maui.Viewer;assembly=C1.Maui.Viewer"
             xmlns:local="clr-namespace:FlexViewer"
             xmlns:res="clr-namespace:FlexViewer.Resources"
             x:Class="FlexViewer.FlexReportViewer">

    <Grid RowDefinitions="Auto,*">
        <Picker x:Name="reportPicker" Grid.Row="0"
                Title="{x:Static res:Resources.SelectReportLabel}"
                Margin="12,10"
                SelectedIndexChanged="ReportPicker_SelectedIndexChanged"/>
        <c1:FlexViewer x:Name="flexViewer" Grid.Row="1"
                       StatusBackground="{AppThemeBinding Light=White, Dark=#1A1A28}"
                       StatusForeground="{AppThemeBinding Light=#333333, Dark=#CCCCEE}"/>
        <local:LoadingOverlay x:Name="loadingOverlay" Grid.RowSpan="2" Grid.ZIndex="100"/>
    </Grid>
</ContentPage>
