<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FlexViewer</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Display name -->
    <ApplicationTitle>FlexViewer</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.flexviewer</ApplicationId>
    <ApplicationIdGuid>19fa66df-c1be-4e22-8066-d60abfce29af</ApplicationIdGuid>
    <!-- Versions -->
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="FlexViewer.sa3licx" />
    <None Remove="Resources\Raw\DefaultDocument.pdf" />
    <None Remove="Resources\Raw\FlexCommonTasksSQLite.flxr" />
    <None Remove="Resources\Raw\C1NWind.db" />
    <None Remove="Resources\Raw\FlexCommonTasks.flxr" />
    <BundleResource Remove="Resources\Raw\DefaultDocument.pdf" />
    <BundleResource Remove="Resources\Raw\FlexCommonTasksSQLite.flxr" />
    <BundleResource Remove="Resources\Raw\C1NWind.flxr" />
    <BundleResource Remove="Resources\Raw\FlexCommonTasks.flxr" />
    <EmbeddedResource Include="FlexViewer.sa3licx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <MauiAsset Include="Resources\Raw\DefaultDocument.pdf" LogicalName="DefaultDocument.pdf" />
    <MauiAsset Include="Resources\Raw\FlexCommonTasksSQLite.flxr" LogicalName="FlexCommonTasksSQLite.flxr" />
    <MauiAsset Include="Resources\Raw\C1NWind.db" LogicalName="C1NWind.db" />
    <MauiAsset Include="Resources\Raw\FlexCommonTasks.flxr" LogicalName="FlexCommonTasks.flxr" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="C1.FlexReport" Version="10.0.20261.150" />
    <PackageReference Include="C1.Maui.Viewer">
      <Version>10.0.20261.50-beta</Version>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Maui" Version="12.2.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.90" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update=".sa3licx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Raw\DefaultDocument.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Raw\FlexCommonTasks.flxr">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>