<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlexViewer.MainPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:c1="clr-namespace:C1.Maui.Viewer;assembly=C1.Maui.Viewer">

    <Grid RowDefinitions="54,*" ColumnDefinitions="*,*">

        <!-- App header -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#D6564C" HeightRequest="54">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand: tappable, navigates to product page -->
            <Border Grid.Column="0" Background="Transparent" StrokeThickness="0"
                    HorizontalOptions="Start" VerticalOptions="Center" Margin="12,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="HeaderBrand_Tapped"/>
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 6"
                            Background="#33FFFFFF"
                            WidthRequest="28" HeightRequest="28"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="C1" FontSize="11" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label Text="ComponentOne" FontSize="13" FontAttributes="Bold"
                               TextColor="White" LineBreakMode="NoWrap"/>
                        <Label Text="Maui Controls" FontSize="10"
                               TextColor="#CCffffff" LineBreakMode="NoWrap"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Hamburger -->
            <Button Grid.Column="1" x:Name="MenuPopupButton"
                    WidthRequest="40" HeightRequest="40" CornerRadius="20"
                    BackgroundColor="Transparent"
                    Clicked="MenuPopupButton_Clicked"
                    HorizontalOptions="End" Margin="0,0,12,0"
                    ToolTipProperties.Text="Open document"
                    Text="&#xF035C;" FontSize="19" FontFamily="MDI" TextColor="White">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#26FFFFFF"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#40FFFFFF"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
        </Grid>

        <!-- Viewer -->
        <c1:FlexViewer x:Name="flexViewer" Grid.Row="1" Grid.ColumnSpan="2"/>

        <!-- Document picker overlay -->
        <Grid x:Name="PopupOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" IsVisible="False">

            <BoxView Color="#01000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OverlayBackground_Tapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E8E8E8, Dark=#38384A}"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#252535}"
                    HorizontalOptions="End" VerticalOptions="Start"
                    Margin="0,58,12,0" WidthRequest="300">

                <VerticalStackLayout x:Name="PopupCard" Spacing="0" Padding="12,14">

                    <Label x:Name="PopupSectionLabel"
                           Text="OPEN DOCUMENT"
                           FontSize="10" FontAttributes="Bold" CharacterSpacing="1.2"
                           TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#55556A}"
                           Margin="4,0,0,8"/>

                    <!-- PDF -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            Background="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="PdfItem_Tapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="44,*" Padding="4,8" ColumnSpacing="8">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                    Background="#26D6564C" WidthRequest="32" HeightRequest="32"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="&#xF0226;" FontSize="15" FontFamily="MDI"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="PDF" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#EBEBEB}"/>
                                <Label Text="DefaultDocument.pdf" FontSize="11"
                                       TextColor="{AppThemeBinding Light=#999999, Dark=#666677}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <BoxView HeightRequest="1" Margin="4,4"
                             Color="{AppThemeBinding Light=#F0F0F0, Dark=#2E2E40}"/>

                    <!-- Flex Report -->
                    <toolkit:Expander x:Name="FlexReportExpander" ExpandedChanged="Expander_ExpandedChanged">
                        <toolkit:Expander.Header>
                            <Grid ColumnDefinitions="44,*,Auto" Padding="4,8" ColumnSpacing="8">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                        Background="#26D6564C" WidthRequest="32" HeightRequest="32"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="&#xF0128;" FontSize="15" FontFamily="MDI"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Flex Report" FontSize="14" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#EBEBEB}"/>
                                    <Label Text="Choose a report…" FontSize="11"
                                           TextColor="{AppThemeBinding Light=#999999, Dark=#666677}"/>
                                </VerticalStackLayout>
                                <Label x:Name="FlexReportArrow" Grid.Column="2"
                                       Text="▼" FontSize="10"
                                       TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#55556A}"
                                       VerticalOptions="Center" Margin="0,0,4,0">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={x:Reference FlexReportExpander}, Path=IsExpanded}"
                                                     Value="True">
                                            <Setter Property="Text" Value="▲"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </toolkit:Expander.Header>

                        <VerticalStackLayout Spacing="6" Padding="4,4,4,8">
                            <Label Text="Select a report" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#55556A}"
                                   Margin="4,0,0,0"/>
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E8E8E8, Dark=#38384A}"
                                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#1C1C2A}"
                                    StrokeShape="RoundRectangle 10" Padding="4">
                                <CollectionView x:Name="FlexReportList" HeightRequest="160"
                                                SelectionMode="Single"
                                                SelectionChanged="FlexReportList_SelectionChanged">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,10">
                                                <Label Text="{Binding .}" FontSize="13"
                                                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#DDDDE8}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>
                        </VerticalStackLayout>
                    </toolkit:Expander>

                    <BoxView HeightRequest="1" Margin="4,4"
                             Color="{AppThemeBinding Light=#F0F0F0, Dark=#2E2E40}"/>

                    <!-- Report Service -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            Background="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ReportServiceItem_Tapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="44,*" Padding="4,8" ColumnSpacing="8">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                    Background="#26D6564C" WidthRequest="32" HeightRequest="32"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="&#xF059F;" FontSize="15" FontFamily="MDI"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Report Service" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#EBEBEB}"/>
                                <Label Text="SSRS remote report" FontSize="11"
                                       TextColor="{AppThemeBinding Light=#999999, Dark=#666677}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" IsVisible="False"
              BackgroundColor="#80000000" ZIndex="100">
            <Border Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 12"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Padding="32,24" MinimumWidthRequest="140">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" Color="#D6564C"
                                       WidthRequest="40" HeightRequest="40"
                                       HorizontalOptions="Center"/>
                    <Label x:Name="LoadingLabel" Text="Loading…"
                           TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"
                           FontSize="14" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
