<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlexViewer.MainPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:c1="clr-namespace:C1.Maui.Viewer;assembly=C1.Maui.Viewer">


    <Grid RowDefinitions="50,Auto,*" ColumnDefinitions="*,*">

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#D6564C" HeightRequest="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <HorizontalStackLayout Grid.Column="0" Padding="12,0" VerticalOptions="Center" Spacing="12" HorizontalOptions="Start">
                <Button x:Name="HeaderMenuButton" Text="ComponentOne  |  Maui Controls" BackgroundColor="Transparent" TextColor="White"  Clicked="HeaderMenuButton_Clicked">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#EB6C61"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#FF766A"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Button>
            </HorizontalStackLayout>

            <Button Grid.Column="1" x:Name="MenuPopupButton" WidthRequest="42" HeightRequest="42" CornerRadius="21" BackgroundColor="Transparent"
                Clicked="MenuPopupButton_Clicked" HorizontalOptions="End" Margin="0,0,12,0">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" Size="20" Color="White"/>
                </Button.ImageSource>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#EB6C61"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#FF766A"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
            </Button>
        </Grid>

        <c1:FlexViewer x:Name="flexViewer" Grid.Row="2" Grid.ColumnSpan="2"/>

        <Grid x:Name="PopupOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="False">

            <BoxView Color="#01000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OverlayBackground_Tapped"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border StrokeThickness="0" Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
        HorizontalOptions="End" VerticalOptions="Start" Margin="0,58,12,0" WidthRequest="320">

                <VerticalStackLayout x:Name="PopupCard" Spacing="8" Padding="12">

                    <Button Text="PDF" Clicked="PdfButton_Clicked" Background="#D6564C">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#EB6C61"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#FF766A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>

                    <toolkit:Expander x:Name="FlexReportExpander" ExpandedChanged="Expander_ExpandedChanged">
                        <toolkit:Expander.Header>
                            <Border x:Name="FlexHeader"
                        Background="#D6564C" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10" HeightRequest="44">
                
                                <Grid ColumnDefinitions="Auto,Auto" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="Flex Report" TextColor="White" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" x:Name="FlexReportArrow" Text=" ▼" TextColor="White" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={x:Reference FlexReportExpander}, Path=IsExpanded}"  Value="True">
                                                <Setter Property="Text" Value=" ▲"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="Background" Value="#EB6C61"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Background" Value="#FF766A"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </toolkit:Expander.Header>

                        <VerticalStackLayout Spacing="8" Padding="8,0,12,12" Margin="0,8,0,0">
                            <Label Text="Select a Flex Report" FontSize="14" Margin="0,0,0,4"/>
                            <Border StrokeThickness="1" Stroke="#D9D9D9" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"  StrokeShape="RoundRectangle 10" Padding="10" Margin="0,4,0,8">
                                <CollectionView x:Name="FlexReportList" HeightRequest="180" SelectionMode="Single" SelectionChanged="FlexReportList_SelectionChanged">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="10">
                                                <Label Text="{Binding .}" FontSize="14" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>
                        </VerticalStackLayout>
                    </toolkit:Expander>

                    <Button Text="Report Service" Clicked="ReportServiceMenu_Clicked" Background="#D6564C">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#EB6C61"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#FF766A"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
