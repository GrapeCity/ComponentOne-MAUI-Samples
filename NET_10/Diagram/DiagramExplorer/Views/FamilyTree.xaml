<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:DiagramExplorer.Views"
             x:Class="DiagramExplorer.FamilyTree"
             xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
             Title="Family Tree">
    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <views:DiagramEditor />

        <c1:FlexDiagram x:Name="diagram" Grid.Row="1" ScaleMode="ScaleToFit"/>
    </Grid>
</ContentPage>