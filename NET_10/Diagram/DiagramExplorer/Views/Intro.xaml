<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DiagramExplorer"
             xmlns:views="clr-namespace:DiagramExplorer.Views"
             x:Class="DiagramExplorer.Intro"
             xmlns:c1="http://schemas.componentone.com/winfx/2006/xaml"
             Title="Intro Page">
    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <views:DiagramEditor Controls="All" />
        
        <c1:FlexDiagram x:Name="diagram" Grid.Row="1" LegendPosition="None">
            <!--<c1:FlexDiagram.NodeTemplate>
                <DataTemplate>
                    <Border Stroke="Blue" StrokeThickness="1" >
                        <Label Text="{Binding Title}" TextColor="Red" Padding="16"  LineBreakMode="NoWrap" />
                    </Border>
                </DataTemplate>
            </c1:FlexDiagram.NodeTemplate>-->
            <c1:Node Title="Start" ID="start" Shape="Rectangle" LegendItem="Start" />
            <c1:Node Title="Decision" ID="decision" LegendItem="Decision"/>
            <c1:Node Title="Option A" ID="optionA" LegendItem="Option"/>
            <c1:Node Title="Option B" ID="optionB" LegendItem="Option"/>
            <c1:Node Title="Option C" ID="optionC" LegendItem="Option"/>
            <c1:FlexDiagram.Edges>
                <c1:Edge SourceID="start" TargetID="decision" TargetArrow="Normal" />
                <c1:Edge SourceID="decision" TargetID="optionA" TargetArrow="Normal" />
                <c1:Edge SourceID="decision" TargetID="optionB" TargetArrow="Normal" />
                <c1:Edge SourceID="decision" TargetID="optionC" TargetArrow="Normal" />
            </c1:FlexDiagram.Edges>
        </c1:FlexDiagram>
    </Grid>
</ContentPage>